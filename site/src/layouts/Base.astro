---
import { Font } from 'astro:assets';
import Sprite from '../components/Sprite.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og.png', Astro.site).href;
const ogAlt = 'The Logn icon and its Smart and Lossless capsule, above the words: Drag. Drop. Smaller.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Logn',
  url: canonical,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS 26 or later, Apple Silicon',
  description: 'A menu-bar app for macOS that compresses any file. Originals are never overwritten, and everything runs on device.',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f7fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#06080e" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Logn" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Drag any file. Drop it on Smart or Lossless. Smaller, with the original untouched. A menu-bar app for macOS, all on device." />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Drag any file. Drop it on Smart or Lossless. Smaller, with the original untouched." />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-math" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Sprite />
    <slot />
    <script>
      import '../scripts/page.ts';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 200;
    padding: 10px 16px;
    border-radius: 10px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
    transition: top 0.15s;
  }
  .skip:focus { top: 12px; }
</style>
