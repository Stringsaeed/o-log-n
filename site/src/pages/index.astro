---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Results from '../components/Results.astro';
import App from '../components/App.astro';
import Safety from '../components/Safety.astro';
import How from '../components/How.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Logn — compress any file on your Mac"
  description="Logn is a menu-bar app for macOS that compresses any file. Drag a file, drop it on Smart or Lossless, done. Originals are never overwritten, and everything runs on device."
>
  <Nav />
  <main id="main">
    <Hero />
    <Results />
    <App />
    <Safety />
    <How />
    <Install />
  </main>
  <Footer />
</Base>
