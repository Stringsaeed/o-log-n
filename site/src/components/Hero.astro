---
import InkIcon from './InkIcon.astro';
import DownloadButton from './DownloadButton.astro';
import Icon from './Icon.astro';
import Stage from './Stage.astro';
import HeroPlot from './HeroPlot.astro';
import { REQUIREMENTS } from '../config';
---
<section class="hero" aria-labelledby="hero-h">
  <div class="wrap">
    <div class="copy">
      <HeroPlot />
      <InkIcon size={112} class="icon" />
      <p class="kicker"><span class="math">O(log <i>n</i>)</span> for your files</p>
      <h1 id="hero-h">
        Drag. Drop.
        <span class="small">Smaller.<svg class="flourish" viewBox="0 0 260 16" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M3 9C38 3 84 13 132 7S222 4 257 8M34 14C92 9 158 15 226 11" pathLength="1" vector-effect="non-scaling-stroke" /></svg></span>
      </h1>
      <p class="lede"><b>Abstract.</b> Logn is a menu-bar app that compresses any file on your Mac. No window, nothing leaves your device, and the original is never overwritten.</p>
      <div class="cta">
        <DownloadButton />
        <a class="btn btn-ghost" href="#results">See the numbers <Icon name="arrow-down" size={16} /></a>
      </div>
      <p class="fine">{REQUIREMENTS} · runs entirely on device</p>
    </div>
    <div class="demo" id="demo">
      <h2 class="sr">Try it here: a simulation of the Logn capsule</h2>
      <Stage />
      <p class="note foot">Sample sizes are the real sizes of files in the 13-file test set. “After” sizes are worked out from the measured percentage, so they are rounded.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow-x: clip;
    padding-top: clamp(36px, 6vw, 64px);
    padding-bottom: clamp(24px, 4vw, 40px);
  }
  .copy {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .copy :global(.icon) { margin: 0 0 12px 10px; }
  /* A paper-coloured edge around the title block's letters, so the curve,
     its shading and the grid never run through the text. */
  .kicker, h1, .lede, .fine {
    -webkit-text-stroke: 0.3em var(--paper);
    paint-order: stroke fill;
  }
  h1 { -webkit-text-stroke-width: 0.12em; }
  .kicker {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    color: var(--ink-2);
    font-size: 1.1875rem;
    font-style: italic;
  }
  .kicker .math { color: var(--ink); font-size: 1.4em; font-style: normal; }
  h1 {
    margin-top: 10px;
    font-size: clamp(3rem, 9.4vw, 6.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  /* The last word in italic, underlined by hand. */
  .small { position: relative; display: inline-block; font-style: italic; margin-left: 0.1em; padding-right: 0.06em; }
  .flourish {
    position: absolute;
    left: -2%;
    bottom: -0.1em;
    width: 104%;
    height: 0.2em;
    overflow: visible;
  }
  .flourish path { fill: none; stroke: var(--spot); stroke-width: 2.5; stroke-linecap: round; }
  .lede {
    max-width: 33em;
    margin-top: 30px;
    color: var(--ink-2);
    font-size: clamp(1.1875rem, 1.8vw, 1.375rem);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .lede b { color: var(--ink); }
  .cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 16px; margin-top: 28px; }
  .fine { margin-top: 20px; color: var(--ink-3); font-size: 0.9375rem; }
  .demo { margin-top: clamp(48px, 6vw, 68px); }
  .foot { max-width: 62ch; margin: 22px auto 0; text-align: center; }

  @media (prefers-reduced-motion: no-preference) {
    .flourish path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: pen 0.7s cubic-bezier(0.4, 0, 0.2, 1) 1s forwards; }
  }
  @keyframes pen { to { stroke-dashoffset: 0; } }
</style>
