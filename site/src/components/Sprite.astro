---
// One inline SVG sprite. Icons are referenced with <Icon name="…" />.
---
<svg class="sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <!-- Pen wobble: a slight displacement, so ruled lines look hand-drawn.
         Used on small static drawings only. -->
    <filter id="wobble" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="2" seed="7" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="2.4" xChannelSelector="R" yChannelSelector="G" />
    </filter>
    <!-- Hatch fills for inline drawings. They take the sprite's colour, which is the ink. -->
    <pattern id="p-h1" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
      <line x1="0" y1="3.500" x2="7" y2="3.500" stroke="currentColor" stroke-width="1" />
    </pattern>
    <pattern id="p-h2" width="4.500" height="4.500" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
      <line x1="0" y1="2.250" x2="4.500" y2="2.250" stroke="currentColor" stroke-width="1.050" />
    </pattern>
    <pattern id="p-h2b" width="4.500" height="4.500" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="2.250" x2="4.500" y2="2.250" stroke="currentColor" stroke-width="1.050" />
    </pattern>
    <pattern id="p-h3" width="3.200" height="3.200" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
      <line x1="0" y1="1.600" x2="3.200" y2="1.600" stroke="currentColor" stroke-width="1.100" />
    </pattern>
    <pattern id="p-h3b" width="3.200" height="3.200" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="1.600" x2="3.200" y2="1.600" stroke="currentColor" stroke-width="1.100" />
    </pattern>
    <pattern id="p-h4" width="3.600" height="3.600" patternUnits="userSpaceOnUse" patternTransform="rotate(8)">
      <line x1="0" y1="1.800" x2="3.600" y2="1.800" stroke="currentColor" stroke-width="1" />
    </pattern>
    <symbol id="i-glyph" viewBox="0 0 20 20">
      <path d="M4.5 3.5Q10 10 4.5 16.5M15.5 3.5Q10 10 15.5 16.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <path d="M10 7.9l1.7 2.1-1.7 2.1L8.3 10z" fill="currentColor" />
    </symbol>
    <symbol id="i-smart" viewBox="0 0 20 20">
      <path d="M8 3.5l1.3 3.9a2 2 0 0 0 1.3 1.3L14.5 10l-3.9 1.3a2 2 0 0 0-1.3 1.3L8 16.5l-1.3-3.9a2 2 0 0 0-1.3-1.3L1.500 10l3.900-1.300a2 2 0 0 0 1.300-1.300z" fill="currentColor" />
      <path d="M15.500 2l.6 1.600 1.600.6-1.600.6-.6 1.600-.6-1.600-1.600-.6 1.600-.6zM16 13.600l.5 1.300 1.300.5-1.300.5-.5 1.300-.5-1.300-1.300-.5 1.300-.5z" fill="currentColor" />
    </symbol>
    <symbol id="i-lossless" viewBox="0 0 20 20">
      <path d="M10 2.200l6 2.200v4.900c0 3.600-2.300 6.600-6 8.200-3.700-1.600-6-4.600-6-8.200V4.400z" fill="none" stroke="currentColor" stroke-width="1.700" stroke-linejoin="round" />
      <path d="M7.200 9.900l2 2 3.600-3.900" fill="none" stroke="currentColor" stroke-width="1.700" stroke-linecap="round" stroke-linejoin="round" />
    </symbol>
    <symbol id="i-check" viewBox="0 0 20 20">
      <circle cx="10" cy="10" r="9" fill="currentColor" />
      <path d="M6 10.300l2.700 2.700L14 7.400" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </symbol>
    <symbol id="i-equal" viewBox="0 0 20 20">
      <circle cx="10" cy="10" r="8.200" fill="none" stroke="currentColor" stroke-width="1.600" />
      <path d="M6.500 8h7M6.500 12h7" stroke="currentColor" stroke-width="1.700" stroke-linecap="round" />
    </symbol>
    <symbol id="i-download" viewBox="0 0 20 20">
      <path d="M10 3v9.500M6 9l4 4 4-4M4 16.500h12" fill="none" stroke="currentColor" stroke-width="1.800" stroke-linecap="round" stroke-linejoin="round" />
    </symbol>
    <symbol id="i-arrow-down" viewBox="0 0 20 20">
      <path d="M10 4v12M5 11l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.800" stroke-linecap="round" stroke-linejoin="round" />
    </symbol>
    <symbol id="i-clock" viewBox="0 0 20 20">
      <circle cx="10" cy="10" r="7.500" fill="none" stroke="currentColor" stroke-width="1.600" />
      <path d="M10 5.800V10l2.800 1.800" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" stroke-linejoin="round" />
    </symbol>
    <symbol id="i-copy" viewBox="0 0 20 20">
      <rect x="7" y="7" width="9.500" height="9.500" rx="2.200" fill="none" stroke="currentColor" stroke-width="1.600" />
      <path d="M13 4.500H6A2.500 2.500 0 0 0 3.500 7v6" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" />
    </symbol>
    <symbol id="i-file" viewBox="0 0 20 20">
      <path d="M5.500 2.500h6l3.500 3.500v10a1.500 1.500 0 0 1-1.500 1.500h-8A1.500 1.500 0 0 1 4 16V4a1.500 1.500 0 0 1 1.500-1.500z" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linejoin="round" />
      <path d="M11.500 2.500V6H15" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linejoin="round" />
    </symbol>
    <symbol id="i-shield" viewBox="0 0 20 20">
      <path d="M10 2.200l6 2.200v4.900c0 3.600-2.300 6.600-6 8.200-3.700-1.600-6-4.600-6-8.200V4.400z" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linejoin="round" />
    </symbol>
    <symbol id="i-undo" viewBox="0 0 20 20">
      <path d="M7 4.500L3.500 8 7 11.500" fill="none" stroke="currentColor" stroke-width="1.700" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M4 8h7.500a4.500 4.500 0 0 1 0 9H8" fill="none" stroke="currentColor" stroke-width="1.700" stroke-linecap="round" />
    </symbol>
    <symbol id="i-layers" viewBox="0 0 20 20">
      <path d="M10 3l7 3.800-7 3.800-7-3.800z" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linejoin="round" />
      <path d="M3.500 10.400l6.500 3.500 6.500-3.500M3.500 13.600l6.500 3.500 6.500-3.500" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" stroke-linejoin="round" />
    </symbol>
    <symbol id="i-shrink" viewBox="0 0 20 20">
      <path d="M3 3l5 5M8 4v4H4M17 17l-5-5M12 16v-4h4" fill="none" stroke="currentColor" stroke-width="1.700" stroke-linecap="round" stroke-linejoin="round" />
    </symbol>
    <symbol id="i-chip" viewBox="0 0 20 20">
      <rect x="5" y="5" width="10" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.600" />
      <path d="M8 2.500V5M12 2.500V5M8 15v2.500M12 15v2.500M2.500 8H5M2.500 12H5M15 8h2.500M15 12h2.500" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" />
    </symbol>
    <symbol id="i-offline" viewBox="0 0 20 20">
      <path d="M3 8.200a10.500 10.500 0 0 1 14 0M5.600 11a6.800 6.800 0 0 1 8.800 0M8.300 13.800a3 3 0 0 1 3.400 0" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" />
      <path d="M4 3.500l12 13" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" />
    </symbol>
    <symbol id="i-user-off" viewBox="0 0 20 20">
      <circle cx="10" cy="7" r="3.200" fill="none" stroke="currentColor" stroke-width="1.600" />
      <path d="M4 16.500c.8-2.800 3.100-4.300 6-4.300s5.200 1.500 6 4.300" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" />
      <path d="M4 3.500l12 13" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" />
    </symbol>
  </defs>
</svg>

<style>
  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; color: var(--ink); }
</style>
