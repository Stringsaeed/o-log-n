---
import AppIcon from './AppIcon.astro';
import DownloadButton from './DownloadButton.astro';
import Icon from './Icon.astro';
import { BREW_COMMAND, BREW_LIVE, downloadLive, REQUIREMENTS } from '../config';

const lead = downloadLive && BREW_LIVE
  ? 'Two ways in. Pick whichever you like.'
  : downloadLive || BREW_LIVE
    ? 'One route is live. The other is on its way.'
    : 'Not out yet. The first notarized release is still on its way, so neither route below works today. This page will switch on when it does.';
---
<section class="sec" id="install" aria-labelledby="install-h">
  <div class="wrap">
    <div class="band" data-reveal>
      <div class="wall" aria-hidden="true"></div>
      <AppIcon size={72} class="icon" />
      <h2 id="install-h" class="h2">Get Logn.</h2>
      <p class="lead">{lead}</p>

      <div class="routes">
        <div class="route">
          <div class="rt"><h3>Direct download</h3><span class:list={['badge', downloadLive && 'live']}>{downloadLive ? 'Available' : 'Coming soon'}</span></div>
          <DownloadButton class="wide" />
          <p>A DMG for {REQUIREMENTS.replace(' · ', ' on ')}.</p>
        </div>
        <div class="route">
          <div class="rt"><h3>Homebrew</h3><span class:list={['badge', BREW_LIVE && 'live']}>{BREW_LIVE ? 'Live' : 'Not live yet'}</span></div>
          <div class="code">
            <code id="brew-cmd" class="mono">{BREW_COMMAND}</code>
            <button type="button" class="copy" id="brew-copy" disabled={!BREW_LIVE}><Icon name="copy" size={15} /><span>Copy</span></button>
          </div>
          {!BREW_LIVE && <p>The tap isn’t published yet, so this command will fail for now.</p>}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(36px, 6vw, 72px) clamp(16px, 4vw, 56px) clamp(20px, 4vw, 56px);
    border-radius: var(--r-xl);
    color: #fff;
    text-align: center;
    box-shadow: var(--shadow-lg);
  }
  .wall {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 70% at 10% 110%, rgba(52, 211, 153, 0.36), transparent 62%),
      radial-gradient(55% 60% at 96% -8%, rgba(129, 102, 255, 0.5), transparent 64%),
      radial-gradient(90% 90% at 50% 0%, #2350de 0%, #1a3fc0 38%, #0c1f73 72%, #070f3d 100%);
  }
  .band :global(.icon) { width: 72px; height: 72px; margin-bottom: 20px; filter: drop-shadow(0 12px 20px rgba(0, 0, 40, 0.45)); }
  .lead { max-width: 52ch; margin-top: 14px; color: rgba(255, 255, 255, 0.86); font-size: 1.0625rem; text-wrap: pretty; }

  .routes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    width: 100%;
    max-width: 860px;
    margin-top: clamp(28px, 4vw, 44px);
    text-align: left;
  }
  @media (max-width: 760px) { .routes { grid-template-columns: minmax(0, 1fr); } }
  .route {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    border-radius: 22px;
    background: rgba(8, 12, 34, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }
  .rt { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  h3 { font-size: 1.0625rem; font-weight: 600; }
  .badge {
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(252, 211, 77, 0.16);
    color: #fde08a;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .badge.live { background: rgba(52, 211, 153, 0.2); color: #7ff0c4; }
  .route p { color: rgba(255, 255, 255, 0.78); font-size: 0.875rem; line-height: 1.45; }
  .route :global(.wide) { width: 100%; }
  .route :global(.btn-soon) { background: rgba(255, 255, 255, 0.07); border-color: rgba(255, 255, 255, 0.3); color: rgba(255, 255, 255, 0.86); }
  .route :global(.btn-primary) { background: #fff; color: #0b1b52; box-shadow: 0 10px 24px -10px rgba(0, 0, 40, 0.7); }
  .route :global(a.btn-primary[href]:hover) { background: #eef2ff; }

  .code {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 46px;
    padding: 5px 5px 5px 14px;
    border-radius: 14px;
    background: rgba(0, 0, 20, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  code { flex: 1; min-width: 0; padding-block: 6px; overflow-wrap: anywhere; font-size: 0.8125rem; line-height: 1.4; color: #e6ecff; }
  .copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .copy:hover:not(:disabled) { background: rgba(255, 255, 255, 0.2); }
  .copy:focus-visible { outline: 2px solid #fff; }
  .copy:disabled { color: rgba(255, 255, 255, 0.62); cursor: not-allowed; background: transparent; }

  @media (prefers-reduced-transparency: reduce) {
    .route { background: #0b1030; -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
</style>
