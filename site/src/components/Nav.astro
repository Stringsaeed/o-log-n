---
import AppIcon from './AppIcon.astro';
---
<header class="nav-shell">
  <nav class="nav" aria-label="Primary">
    <a class="brand" href="/" aria-label="Logn, home"><AppIcon size={28} eager /><span>Logn</span></a>
    <ul class="links">
      <li><a href="#results">Results</a></li>
      <li><a href="#app">The app</a></li>
      <li><a href="#safety">Safety</a></li>
      <li><a href="#how">Under the hood</a></li>
    </ul>
    <a class="cta" href="#install">Get Logn</a>
  </nav>
</header>

<style>
  .nav-shell {
    position: sticky;
    top: 12px;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding-inline: var(--gutter);
    pointer-events: none;
    transition: opacity 0.18s, visibility 0.18s;
  }
  /* A dragged file summons the capsule to the top of the viewport; step aside for it. */
  :global(html.capsule-floating) .nav-shell { opacity: 0; visibility: hidden; }
  .nav {
    position: relative;
    isolation: isolate;
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 28px);
    padding: 6px 6px 6px 12px;
    border-radius: 999px;
  }
  /* The sheet, and its hatched shadow. */
  .nav::before, .nav::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .nav::before { z-index: -1; border: var(--stroke) solid var(--ink); background-color: var(--paper); }
  .nav::after {
    z-index: -2;
    background-color: var(--ink);
    -webkit-mask-image: var(--hatch-3);
    mask-image: var(--hatch-3);
    transform: translate(4px, 5px);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
  }
  .brand :global(img) { width: 28px; height: 28px; }
  .links { display: flex; gap: 2px; }
  .links a {
    display: block;
    padding: 6px 12px;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 1.0625rem;
    text-decoration: none;
  }
  .links a:hover { color: var(--ink); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 5px; }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .cta:hover { background: var(--spot); }
  @media (max-width: 760px) {
    .nav { width: 100%; justify-content: space-between; }
    .links { display: none; }
  }
</style>
