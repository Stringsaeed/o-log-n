---
// A number line from 0 to n with a point at what is left of the sample.
// Decorative: the percentage beside it carries the value.
interface Props {
  /** Percent of the sample that remains, 0–100. */
  left: number;
  small?: boolean;
}
const { left, small = false } = Astro.props;
const x = `${Math.min(100, Math.max(0, left))}%`;
---
<div class:list={['nl', small && 'small']} aria-hidden="true">
  <svg width="100%" height="14" focusable="false">
    <line class="axis" x1="0" x2="100%" y1="7" y2="7" />
    <line class="tick" x1="0" x2="0" y1="2" y2="12" />
    <line class="tick" x1="100%" x2="100%" y1="2" y2="12" />
    <line class="fill" x1="0" x2={x} y1="7" y2="7" />
    <circle class="dot" cx={x} cy="7" r="4.5" />
  </svg>
  {!small && <div class="ends math"><span>0</span><span><i>n</i></span></div>}
</div>

<style>
  .nl { margin-top: 14px; padding-inline: 5px; }
  .nl.small { margin-top: 10px; }
  svg { display: block; overflow: visible; }
  .axis { stroke: var(--ink); stroke-width: 1; }
  .tick { stroke: var(--ink); stroke-width: 1.5; }
  .fill { stroke: var(--ink); stroke-width: 3.5; }
  .dot { fill: var(--paper); stroke: var(--ink); stroke-width: 2; }
  .small .fill { stroke-width: 2.5; }
  .small .axis, .small .tick { stroke: var(--ink-3); }
  .ends { display: flex; justify-content: space-between; margin: 3px -3px 0; color: var(--ink-2); font-size: 1rem; }
</style>
