---
import Icon from './Icon.astro';
import { REQUIREMENTS } from '../config';

const groups = [
  { title: 'Native Apple frameworks', tags: [['ImageIO'], ['VideoToolbox'], ['AudioToolbox'], ['PDFKit / Quartz'], ['Compression']] },
  { title: 'Two vendored open-source libraries', tags: [['libdeflate', 'MIT'], ['libjpeg-turbo', 'BSD / IJG']] },
  { title: 'Logn’s own', tags: [['PNG optimiser'], ['Oklab colour quantiser']] },
];
const facts = [
  { icon: 'chip', k: 'Where it runs', v: 'On your Mac. Everything happens on device.' },
  { icon: 'offline', k: 'Network', v: 'None.' },
  { icon: 'user-off', k: 'Account', v: 'None.' },
  { icon: 'layers', k: 'Requires', v: REQUIREMENTS.replace(' · ', ', on ') + '.' },
];
---
<section class="sec how" id="how" aria-labelledby="how-h">
  <div class="wrap grid">
    <div data-reveal>
      <p class="eyebrow">Under the hood</p>
      <h2 id="how-h" class="h2">Mostly <span class="pinch">your Mac itself.</span></h2>
      <div class="groups">
        {groups.map((g) => (
          <div>
            <h3>{g.title}</h3>
            <ul class="tags">
              {g.tags.map(([name, lic]) => <li>{name}{lic && <small>{lic}</small>}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="card facts" data-reveal>
      <dl>
        {facts.map((f) => (
          <div>
            <dt><span class="ico"><Icon name={f.icon} size={18} /></span>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
      <p class="name">The repo is called <span class="mono">o-log-n</span>, as in <span class="mono">O(log n)</span>: big input, small result.</p>
    </div>
  </div>
</section>

<style>
  .how { background: var(--bg-2); border-block: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  @media (max-width: 900px) { .grid { grid-template-columns: minmax(0, 1fr); } }
  .groups { display: grid; gap: 24px; margin-top: 36px; }
  h3 { color: var(--ink-3); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .tags li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.9375rem;
    font-weight: 500;
    box-shadow: var(--shadow-sm);
  }
  .tags small {
    padding: 3px 7px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--ink-2);
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .facts { padding: clamp(8px, 1.4vw, 14px) clamp(20px, 2.6vw, 28px) clamp(20px, 2.6vw, 28px); }
  dl > div {
    position: relative;
    padding: 18px 0 18px 50px;
    border-bottom: 1px solid var(--line);
  }
  .ico {
    position: absolute;
    left: 0;
    top: 20px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--ink-2);
  }
  dt { color: var(--ink-3); font-size: 0.8125rem; font-weight: 600; }
  dd { font-size: 1rem; font-weight: 500; }
  .name { margin-top: 18px; color: var(--ink-2); font-size: 0.9375rem; line-height: 1.5; }
  .name .mono { color: var(--ink); font-size: 0.9em; }
</style>
