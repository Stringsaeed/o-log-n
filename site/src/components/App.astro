---
// The app itself: real screenshots from demo mode.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Shot from './Shot.astro';
import smart from '../assets/drop-smart-dark.png';
import lossless from '../assets/drop-lossless-dark.png';
import working from '../assets/drop-compressing-dark.png';
import done from '../assets/drop-done-dark.png';
import tray from '../assets/tray-dark.png';
import settings from '../assets/settings-dark.png';

const states = [
  { img: smart, name: 'Smart', text: 'The smallest file that still looks or sounds identical.', alt: 'Capsule with the Smart half highlighted: Drop to shrink.' },
  { img: lossless, name: 'Lossless', text: 'Exact content, checked before it’s written.', alt: 'Capsule with the Lossless half highlighted: Drop exact.' },
  { img: working, name: 'Working', text: 'The halves merge into one progress pill.', alt: 'The capsule as a progress pill with a ring, a file name and a speed.' },
  { img: done, name: 'Done', text: 'The saving, then it gets out of your way.', alt: 'The capsule as a done pill showing a saving and a file name.' },
];
---
<section class="sec sec-alt app" id="app" aria-labelledby="app-h">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <p class="eyebrow"><span class="math">§2</span>Two surfaces, no window</p>
      <h2 id="app-h" class="h2">It shows up <span class="pinch">when you drag.</span></h2>
      <p class="sub">Logn lives in the menu bar. Start dragging any file, anywhere, and a glass capsule slides in at the top-centre of the screen.</p>
    </div>

    <div class="bento">
      <article class="card states" data-reveal>
        <ol>
          {states.map((s) => (
            <li>
              <Image src={s.img} alt={s.alt} width={336} height={128} densities={[1, 2]} format="webp" quality={82} loading="lazy" decoding="async" />
              <p><b>{s.name}</b>{s.text}</p>
            </li>
          ))}
        </ol>
      </article>

      <article class="card flip" data-reveal>
        <div class="flip-art" aria-hidden="true">
          <span class="mini"><i><Icon name="smart" size={14} />Smart</i><i><Icon name="lossless" size={14} />Lossless</i></span>
          <span class="key">⌥</span>
          <span class="mini flipped"><i><Icon name="smart" size={14} />Smart</i><i><Icon name="lossless" size={14} />Lossless</i></span>
        </div>
        <h3>Hold <kbd>⌥</kbd> to flip the targeted half.</h3>
        <p>It switches between Smart and Lossless in place, so there is no sideways aiming.</p>
      </article>

      <article class="card speed" data-reveal>
        <p class="stat"><span class="math t" aria-hidden="true"><i>t</i> ≈</span><span class="num">65</span><span class="unit">ms</span></p>
        <h3>The tray opens in about 65&nbsp;ms.</h3>
      </article>

      <article class="card tray" data-reveal>
        <div class="tray-head">
          <h3><span class="keys"><span class="sr">Control Option Space</span><span aria-hidden="true"><kbd>⌃</kbd><kbd>⌥</kbd><kbd class="space">Space</kbd></span></span> opens the tray.</h3>
          <p>A Liquid Glass tray across the bottom quarter of the screen, with the live queue, history and settings.</p>
        </div>
        <figure>
          <figcaption>The queue</figcaption>
          <Shot
            src={tray}
            label="Screenshot of the Logn tray. Scrolls sideways on small screens."
            alt="The Logn tray: mode and quality controls along the top, a drop well on the left, and a queue of files on the right, with a toast offering to undo a replaced original."
          />
        </figure>
        <figure>
          <figcaption>Settings</figcaption>
          <Shot
            src={settings}
            label="Screenshot of Logn settings. Scrolls sideways on small screens."
            alt="Settings, shown inside the tray: presence, compression and output options in three columns."
          />
        </figure>
        <p class="cap">Real screenshots, taken in the app’s built-in demo mode. The file names and figures inside them are placeholders, not measurements.</p>
      </article>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px 22px;
  }
  .card { padding: clamp(20px, 2.6vw, 28px); }
  h3 { font-size: 1.375rem; font-weight: 700; line-height: 1.2; }
  .card > p, .tray-head p { margin-top: 8px; color: var(--ink-2); font-size: 1.0625rem; line-height: 1.4; }

  .states { grid-column: span 7; grid-row: span 2; }
  .states ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 18px; height: 100%; align-content: space-between; }
  /* Real screenshots, framed as plates. */
  .states :global(img) { width: 100%; height: auto; border-radius: 8px; outline: var(--stroke) solid var(--ink); }
  .states li p { margin-top: 12px; color: var(--ink-2); font-size: 1.0625rem; line-height: 1.35; }
  .states li b { display: block; color: var(--ink); font-size: 1.125rem; }

  .flip, .speed { grid-column: span 5; }
  /* A diagram of the gesture, drawn in outline. */
  .flip-art {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 20px;
    padding: 22px 12px;
    border-radius: 10px;
    border: var(--stroke) dashed var(--rule-2);
  }
  .mini {
    display: flex;
    padding: 3px;
    border-radius: 999px;
    border: var(--stroke) solid var(--ink);
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .mini i { display: flex; align-items: center; gap: 4px; padding: 7px 9px; border-radius: 999px; font-style: normal; }
  .mini:not(.flipped) i:first-child, .mini.flipped i:last-child { background: var(--ink); color: var(--paper); }
  .key {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 7px;
    border: var(--stroke) solid var(--ink);
    border-bottom-width: 4px;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
  }
  @media (max-width: 420px) { .mini i { padding: 6px 7px; } .mini :global(svg) { display: none; } }

  .speed { display: flex; flex-direction: column; justify-content: flex-end; }
  .card > .stat { display: flex; align-items: baseline; gap: 8px; margin: 0 0 10px; color: var(--ink); }
  .num { font-size: clamp(4rem, 7.4vw, 5.5rem); font-weight: 700; line-height: 0.9; letter-spacing: -0.02em; }
  .unit { color: var(--ink-2); font-size: 1.5rem; font-style: italic; }
  .t { margin-right: 4px; color: var(--ink-2); font-size: 2.25rem; }

  .tray { grid-column: 1 / -1; display: grid; gap: 20px; }
  .tray-head { max-width: 58ch; }
  .tray-head h3 { font-size: clamp(1.375rem, 2.4vw, 1.75rem); }
  .keys kbd { margin-right: 5px; }
  .keys .space { padding-inline: 0.7em; }
  figure { display: grid; gap: 10px; min-width: 0; }
  figcaption { color: var(--ink-2); font-size: 0.875rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .cap { color: var(--ink-3); font-size: 0.9375rem; line-height: 1.4; font-style: italic; }

  @media (max-width: 900px) {
    .states, .flip, .speed { grid-column: 1 / -1; grid-row: auto; }
  }
  @media (max-width: 520px) {
    .states ol { grid-template-columns: minmax(0, 1fr); }
  }
</style>
