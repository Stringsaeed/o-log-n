---
// The demo: a stylised desktop with the Smart | Lossless capsule.
// It is a simulation. Behaviour lives in src/scripts/demo.ts and every
// figure it shows comes from src/data/results.ts.
import Icon from './Icon.astro';
import { KINDS, SAMPLE_ORDER, formatBytes, formatLeft, formatPct } from '../data/results';
import { logCurve } from '../lib/curve';

const samples = SAMPLE_ORDER.map((id) => ({ id, ...KINDS[id] }));
const first = samples[0];
const firstAfter = Math.round(first.bytes * (1 - first.smart!.pct / 100));
---
<div class="stage" id="stage">
  <div class="wall" aria-hidden="true">
    <div class="wall-grid"></div>
    <svg class="wall-curve" viewBox="0 0 1000 400" preserveAspectRatio="none" focusable="false">
      <path d={logCurve(1000, 400)} fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
    </svg>
  </div>

  <div class="menubar" aria-hidden="true">
    <span class="mb-l"><b>Desktop</b><span>File</span><span>Edit</span><span>View</span></span>
    <span class="mb-r"><span class="mb-app"><Icon name="glyph" size={15} /></span><span class="mb-dots"><i></i><i></i><i></i></span></span>
  </div>

  <div class="cap-slot">
    <div class="capsule" id="capsule" data-state="idle" role="group" aria-label="Logn drop target (simulated)">
      <div class="halves">
        <button type="button" class="half" data-side="l" data-mode="smart">
          <span class="half-t"><Icon name="smart" size={17} /><b>Smart</b></span>
          <small>Smallest</small>
        </button>
        <span class="seam" aria-hidden="true"></span>
        <button type="button" class="half" data-side="r" data-mode="lossless">
          <span class="half-t"><Icon name="lossless" size={17} /><b>Lossless</b></span>
          <small>Exact quality</small>
        </button>
      </div>
      <div class="cpill cpill-busy" aria-hidden="true">
        <svg class="ring" viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="14" r="11" /><circle class="ring-v" cx="14" cy="14" r="11" pathLength="100" /></svg>
        <span class="cpill-txt"><b id="busy-name">file</b><small id="busy-sub">Smart</small></span>
      </div>
      <button type="button" class="cpill cpill-done" id="done-pill" tabindex="-1" aria-hidden="true">
        <svg class="done-ico" width="22" height="22" aria-hidden="true"><use id="done-use" href="#i-check" /></svg>
        <span class="cpill-txt"><b id="done-big">−0%</b><small id="done-sub">Saved</small></span>
      </button>
    </div>
  </div>
  <p class="cap-hint">Drag a file onto a half. Or tap a file, then a half.</p>

  <noscript><p class="noscript">The demo needs JavaScript. Everything it would show is in the results below.</p></noscript>

  <div class="stage-body">
    <div class="desk">
      <p class="sr" id="chips-h">Sample files from our test set</p>
      <ul class="files" aria-labelledby="chips-h">
        {samples.map((s, i) => (
          <li>
            <div role="button" tabindex="0" class="chip" draggable="true" data-kind={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              <i class:list={['doc', s.id === 'folder' && 'doc-folder']} data-ext={s.ext} aria-hidden="true"></i>
              <b>{s.short}{s.ext && <span class="sr">, {s.ext}</span>}</b>
              <small class="mono">{formatBytes(s.bytes)}</small>
            </div>
          </li>
        ))}
        <li class="own-li">
          <label class="chip own"><input type="file" id="own" class="sr" /><i class="plus" aria-hidden="true"></i><b>Your file</b><small>Estimate only</small></label>
        </li>
      </ul>
      <div class="desk-tools">
        <button type="button" class="tool" id="flip" aria-pressed="false"><kbd>⌥</kbd> Flip the halves</button>
      </div>
      <p class="desk-note">Your own file stays in this tab. Only its name and size are looked at, to show an estimate.</p>
    </div>

    <div class="result" id="result" data-state="empty">
      <p class="sr" id="live" role="status" aria-live="polite"></p>
      <div class="result-empty">
        <span class="result-glyph" aria-hidden="true"><Icon name="arrow-down" size={18} /></span>
        <p class="result-hint"><b>{first.file}</b> is picked. Now choose Smart or Lossless on the capsule.</p>
      </div>
      <div class="result-card" aria-hidden="true">
        <div class="rc-top">
          <span class="rc-file" id="rc-file">{first.file}</span>
          <span class="rc-mode" id="rc-mode">Smart</span>
        </div>
        <p class="rc-big" id="rc-big">{formatPct(first.smart!.pct)}</p>
        <div class="rc-bars" aria-hidden="true">
          <div class="rc-bar rc-before"><i></i></div>
          <div class="rc-bar rc-after"><i id="rc-after-bar"></i></div>
        </div>
        <p class="rc-sizes mono" id="rc-sizes">{formatBytes(first.bytes)} → {formatBytes(firstAfter)}</p>
        <p class="rc-fn math" id="rc-fn" aria-hidden="true"><i>n</i> ↦ {formatLeft(first.smart!.pct)}<i>n</i></p>
        <p class="rc-method" id="rc-method">{first.smart!.how}</p>
        <p class="rc-note" id="rc-note"></p>
        <p class="rc-foot" id="rc-foot">Simulated here. The figure was measured on this sample in our 13-file test set.</p>
      </div>
    </div>
  </div>

  <p class="sim-badge"><span class="sim-dot" aria-hidden="true"></span><b>Simulation.</b> Nothing is uploaded, read or compressed.</p>
</div>

<script>
  import '../scripts/demo.ts';
</script>

<style>
  /* The stage is a dark "desktop" in both colour schemes, like a wallpaper. */
  .stage {
    --w: rgba(255, 255, 255, 0.92);
    --w-2: rgba(255, 255, 255, 0.86);
    --glass: rgba(10, 14, 34, 0.55);
    --glass-line: rgba(255, 255, 255, 0.14);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--r-xl);
    color: #fff;
    background: #0a1440;
    box-shadow: 0 0 0 1px rgba(11, 16, 32, 0.12), var(--shadow-lg);
    padding: 0 clamp(14px, 3vw, 36px) clamp(14px, 2.4vw, 28px);
  }
  @media (prefers-color-scheme: dark) {
    .stage { box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12), var(--shadow-lg); }
  }

  .wall {
    position: absolute;
    inset: 0;
    z-index: -1;
    color: rgba(255, 255, 255, 0.16);
    background:
      radial-gradient(60% 70% at 14% 108%, rgba(52, 211, 153, 0.42), transparent 62%),
      radial-gradient(55% 60% at 96% -8%, rgba(129, 102, 255, 0.55), transparent 64%),
      radial-gradient(90% 90% at 50% 0%, #2350de 0%, #1a3fc0 38%, #0c1f73 72%, #070f3d 100%);
  }
  .wall-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: center top;
    -webkit-mask-image: linear-gradient(#000, transparent 92%);
    mask-image: linear-gradient(#000, transparent 92%);
  }
  .wall-curve {
    position: absolute;
    inset: 32px 0 0;
    width: 100%;
    height: calc(100% - 32px);
  }

  .menubar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 32px;
    margin-inline: calc(clamp(14px, 3vw, 36px) * -1);
    padding-inline: 16px;
    background: rgba(8, 12, 36, 0.32);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8125rem;
    color: var(--w);
  }
  .mb-l, .mb-r { display: flex; align-items: center; gap: 16px; }
  .mb-l b { font-weight: 650; }
  .mb-l span { opacity: 0.82; }
  .mb-app {
    display: grid;
    place-items: center;
    width: 26px;
    height: 22px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.2);
  }
  .mb-dots { display: flex; gap: 5px; }
  .mb-dots i { width: 14px; height: 6px; border-radius: 3px; background: rgba(255, 255, 255, 0.55); }
  .mb-dots i:nth-child(2) { width: 6px; }
  .mb-dots i:nth-child(3) { width: 30px; }
  @media (max-width: 480px) { .mb-l span { display: none; } }

  /* ── capsule ── */
  .cap-slot {
    height: 96px;
    margin-top: 14px;
    display: grid;
    place-items: start center;
  }
  .capsule {
    position: relative;
    width: 300px;
    height: 76px;
    border-radius: 40px;
    background: rgba(18, 22, 40, 0.72);
    -webkit-backdrop-filter: blur(22px) saturate(1.6);
    backdrop-filter: blur(22px) saturate(1.6);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.26),
      0 22px 44px -14px rgba(0, 0, 0, 0.6);
    transition: width 0.34s var(--spring), height 0.34s var(--spring), box-shadow 0.3s;
  }
  .capsule[data-state='armed'], .capsule[data-state='target'] {
    width: 336px;
    height: 88px;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.26),
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 0 0 7px rgba(134, 171, 255, 0.14),
      0 26px 50px -14px rgba(0, 0, 0, 0.65);
  }
  .capsule[data-state='busy'] { width: 256px; height: 60px; }
  .capsule[data-state='done'], .capsule[data-state='optimal'], .capsule[data-state='nodata'] { width: 300px; height: 64px; }
  @media (max-width: 400px) {
    .capsule { width: 280px; }
    .capsule[data-state='armed'], .capsule[data-state='target'] { width: 300px; height: 84px; }
  }

  .capsule.floating {
    position: fixed;
    top: 14px;
    left: 50%;
    margin-left: -168px;
    z-index: 150;
    animation: summon 0.34s var(--spring) both;
  }
  .capsule.floating[data-state='busy'] { margin-left: -128px; }
  .capsule.floating[data-state='done'], .capsule.floating[data-state='optimal'], .capsule.floating[data-state='nodata'] { margin-left: -150px; }
  @keyframes summon {
    from { transform: translateY(-120%); }
    to { transform: none; }
  }

  .halves {
    position: absolute;
    inset: 5px;
    display: flex;
    transition: opacity 0.18s;
  }
  .half {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    border: 1px solid transparent;
    border-radius: 34px;
    background: transparent;
    color: rgba(255, 255, 255, 0.84);
    transition: background-color 0.18s, transform 0.22s var(--spring), opacity 0.18s, border-color 0.18s;
  }
  .half > * { pointer-events: none; }
  .half-t { display: flex; align-items: center; gap: 6px; font-size: 1rem; font-weight: 650; }
  .half small { font-size: 0.78rem; font-weight: 500; color: rgba(255, 255, 255, 0.8); }
  .half:hover, .half.is-target {
    background: rgba(72, 118, 232, 0.5);
    border-color: #86abff;
    color: #fff;
    transform: scale(1.03);
  }
  .half:hover small, .half.is-target small { color: #fff; }
  .half:focus-visible { outline: 2px solid #fff; outline-offset: 2px; border-radius: 34px; }
  .capsule[data-state='target'] .half:not(.is-target) { opacity: 0.62; }
  .seam { width: 1px; margin: 16px 2px; background: rgba(255, 255, 255, 0.2); }

  .cpill {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 0 18px;
    border: 0;
    border-radius: inherit;
    background: none;
    color: #fff;
    text-align: left;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s;
  }
  .cpill-txt { display: flex; flex-direction: column; min-width: 0; line-height: 1.2; }
  .cpill-txt b { font-size: 1rem; font-weight: 650; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cpill-txt small {
    font-size: 0.78rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-variant-numeric: tabular-nums;
  }
  .capsule:is([data-state='busy'], [data-state='done'], [data-state='optimal'], [data-state='nodata']) .halves { opacity: 0; visibility: hidden; }
  .capsule[data-state='busy'] .cpill-busy,
  .capsule:is([data-state='done'], [data-state='optimal'], [data-state='nodata']) .cpill-done { opacity: 1; visibility: visible; }
  .ring { flex: none; width: 30px; height: 30px; transform: rotate(-90deg); }
  .ring circle { fill: none; stroke: rgba(255, 255, 255, 0.2); stroke-width: 3.4; }
  .ring .ring-v { stroke: #7da6ff; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: calc(100 - var(--p, 0)); }
  .done-ico { flex: none; color: #34d399; }
  .cpill-done:focus-visible { outline: 2px solid #fff; outline-offset: 2px; border-radius: 40px; }
  .cpill-done b { color: #5ee0aa; font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .capsule:is([data-state='optimal'], [data-state='nodata']) .cpill-done b { color: #fff; font-size: 1.0625rem; }
  .capsule:is([data-state='optimal'], [data-state='nodata']) .done-ico { color: rgba(255, 255, 255, 0.78); }

  .cap-hint {
    margin-top: 2px;
    text-align: center;
    font-size: 0.875rem;
    color: var(--w-2);
  }
  .noscript {
    margin: 12px auto 0;
    max-width: 46ch;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--glass);
    text-align: center;
    font-size: 0.9375rem;
  }

  /* ── desktop body ── */
  .stage-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
    gap: clamp(20px, 4vw, 56px);
    align-items: start;
    margin-top: clamp(20px, 3vw, 32px);
  }
  @media (max-width: 860px) {
    /* One column: the result sits right under the capsule, so a tap on a half
       shows its answer without scrolling. */
    .stage-body { grid-template-columns: minmax(0, 1fr); margin-top: 14px; }
    .result { order: -1; }
    .cap-hint { display: none; }
  }

  .files {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 4px;
    max-width: 540px;
  }
  @media (max-width: 860px) {
    .files { grid-template-columns: repeat(5, minmax(0, 1fr)); max-width: none; }
  }
  @media (max-width: 560px) {
    .files { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .own-li { grid-column: 1 / -1; }
    .chip.own { flex-direction: row; justify-content: center; gap: 10px; padding-block: 12px; }
    .chip.own b { margin-top: 0; }
    .chip.own .plus { width: 28px; height: 28px; border-radius: 9px; }
  }
  .chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 10px 4px 8px;
    border-radius: 12px;
    border: 1px solid transparent;
    text-align: center;
    cursor: grab;
    -webkit-user-select: none;
    user-select: none;
    touch-action: manipulation;
    transition: transform 0.22s var(--spring), background-color 0.15s, border-color 0.15s;
  }
  .chip:hover { background: rgba(255, 255, 255, 0.1); }
  .chip:active { cursor: grabbing; transform: scale(0.95); }
  .chip:focus-visible { outline: 2px solid #fff; outline-offset: 2px; border-radius: 12px; }
  .chip[aria-pressed='true'] { background: rgba(72, 118, 232, 0.42); border-color: rgba(134, 171, 255, 0.9); }
  .chip.dragging { opacity: 0.45; }
  .chip b {
    max-width: 100%;
    margin-top: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-shadow: 0 1px 3px rgba(0, 0, 20, 0.5);
  }
  .chip small { font-size: 0.72rem; color: var(--w-2); text-shadow: 0 1px 3px rgba(0, 0, 20, 0.5); }

  .chip.own { cursor: pointer; border: 1px dashed rgba(255, 255, 255, 0.42); }
  .chip.own:focus-within { outline: 2px solid #fff; outline-offset: 2px; }
  .plus {
    position: relative;
    width: 40px;
    height: 50px;
    border-radius: 6px 14px 6px 6px;
    background: rgba(255, 255, 255, 0.12);
  }
  .plus::before, .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 2px;
    margin: -1px 0 0 -7px;
    border-radius: 1px;
    background: #fff;
  }
  .plus::after { transform: rotate(90deg); }

  .doc {
    position: relative;
    width: 40px;
    height: 50px;
    border-radius: 6px 14px 6px 6px;
    background: linear-gradient(#ffffff, #d6def5);
    box-shadow: 0 6px 12px -4px rgba(0, 0, 30, 0.5);
  }
  .doc::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 13px;
    height: 13px;
    border-radius: 0 0 0 5px;
    background: linear-gradient(225deg, transparent 50%, #b9c6ea 50%);
  }
  .doc::after {
    content: attr(data-ext);
    position: absolute;
    left: 0;
    right: 0;
    bottom: 7px;
    text-align: center;
    font-size: 0.5625rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.02em;
    color: #1d3fae;
  }
  .doc-folder {
    width: 48px;
    height: 36px;
    margin-block: 9px 5px;
    border-radius: 6px;
    background: linear-gradient(#8ab8ff, #3f7af2);
  }
  .doc-folder::before {
    top: -6px;
    left: 0;
    right: auto;
    width: 20px;
    height: 10px;
    border-radius: 5px 5px 0 0;
    background: #8ab8ff;
  }
  .doc-folder::after { content: none; }

  .desk-tools { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: background-color 0.15s;
  }
  .tool:hover { background: rgba(255, 255, 255, 0.18); }
  .tool:focus-visible { outline: 2px solid #fff; outline-offset: 2px; border-radius: 999px; }
  .tool kbd { background: rgba(255, 255, 255, 0.16); border-color: rgba(255, 255, 255, 0.3); border-bottom-width: 1px; color: #fff; }
  .tool[aria-pressed='true'] { background: #fff; color: #0a1233; border-color: #fff; }
  .tool[aria-pressed='true'] kbd { background: #dbe5ff; border-color: #b9cbff; color: #0a1233; }
  .desk-note { margin-top: 12px; max-width: 46ch; font-size: 0.8125rem; line-height: 1.45; color: var(--w-2); }

  /* ── result panel ── */
  .result {
    position: relative;
    display: grid;
    min-height: 372px;
    padding: 22px;
    border-radius: 22px;
    background: var(--glass);
    border: 1px solid var(--glass-line);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    backdrop-filter: blur(24px) saturate(1.4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 24px 48px -20px rgba(0, 0, 20, 0.6);
  }
  /* One column: the empty panel is short, and grows the moment a half is
     tapped, so the shift is part of the visitor's own action. */
  @media (max-width: 860px) {
    .result { min-height: 336px; }
    .result[data-state='empty'] { min-height: 0; padding-block: 18px; }
    .result[data-state='empty'] .result-card { display: none; }
    .result[data-state='empty'] .result-empty { grid-auto-flow: column; justify-content: start; align-items: center; text-align: left; }
    .result[data-state='empty'] .result-hint { max-width: none; font-size: 0.9375rem; }
  }
  .result-empty, .result-card { grid-area: 1 / 1; }
  .result-empty { display: grid; place-content: center; justify-items: center; gap: 14px; text-align: center; }
  .result-glyph {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.4);
    color: var(--w-2);
    transform: rotate(180deg);
  }
  .result-hint { max-width: 28ch; font-size: 1rem; color: var(--w); }
  .result-hint :global(b) { color: #fff; overflow-wrap: anywhere; }
  .result-card { display: flex; flex-direction: column; opacity: 0; visibility: hidden; }
  .result:is([data-state='shown'], [data-state='busy']) .result-empty { display: none; }
  .result[data-state='shown'] .result-card { opacity: 1; visibility: visible; }
  .result[data-state='busy']::after {
    content: 'Compressing (pretend)…';
    grid-area: 1 / 1;
    place-self: center;
    color: var(--w-2);
    font-size: 0.9375rem;
  }
  .rc-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .rc-file { min-width: 0; font-size: 0.9375rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rc-mode {
    flex: none;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(125, 166, 255, 0.24);
    color: #d3e0ff;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
  }
  .rc-big {
    margin-top: 14px;
    font-size: clamp(4rem, 9vw, 6rem);
    font-weight: 650;
    font-stretch: 75%;
    line-height: 0.95;
