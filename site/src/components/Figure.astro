---
// Fig. 1: a dumbbell chart, original size → Smart output, on a log axis.
// Marks are positioned with SVG percentages only (no inline styles), so the
// Content-Security-Policy holds and the chart scales with its container.
import { KINDS, RESULT_ORDER, formatBytes, formatPct } from '../data/results';

const MIN = 5; // 10^5 B = 100 KB
const DECADES = 3; // up to 10^8 B = 100 MB
const PAD = 4; // percent kept clear at each end
const pos = (bytes: number) => PAD + ((100 - PAD * 2) * (Math.log10(bytes) - MIN)) / DECADES;
const pct = (v: number) => `${v.toFixed(2)}%`;

const ticks = [
  { bytes: 1e5, label: '100 KB' },
  { bytes: 1e6, label: '1 MB' },
  { bytes: 1e7, label: '10 MB' },
  { bytes: 1e8, label: '100 MB' },
].map((t, i, all) => ({ ...t, x: pct(pos(t.bytes)), anchor: i === 0 ? 'start' : i === all.length - 1 ? 'end' : 'middle' }));

const rows = RESULT_ORDER.map((id) => {
  const k = KINDS[id];
  const after = Math.round(k.bytes * (1 - k.smart!.pct / 100));
  return {
    title: k.title,
    saved: formatPct(k.smart!.pct),
    before: formatBytes(k.bytes),
    after: formatBytes(after),
    x1: pct(pos(after)),
    x2: pct(pos(k.bytes)),
    bytes: k.bytes,
  };
}).sort((a, b) => b.bytes - a.bytes);
---
<figure class="fig card" data-reveal>
  <div class="head">
    <ul class="legend" aria-label="Legend">
      <li><svg width="14" height="14" aria-hidden="true"><circle class="before" cx="7" cy="7" r="4.5" /></svg>Original</li>
      <li><svg width="14" height="14" aria-hidden="true"><circle class="after" cx="7" cy="7" r="5.5" /></svg>After Smart</li>
    </ul>
    <p class="readout mono" id="fig-readout" data-default="Hover or focus a row for its sizes.">Hover or focus a row for its sizes.</p>
  </div>

  <ol class="rows">
    {rows.map((r) => (
      <li tabindex="0" data-readout={`${r.before} → ${r.after}  ·  ${r.title}`}>
        <span class="name">{r.title}</span>
        <svg class="track" width="100%" height="36" aria-hidden="true" focusable="false">
          {ticks.map((t) => <line class="grid" x1={t.x} x2={t.x} y1="0" y2="36" />)}
          <line class="link" x1={r.x1} x2={r.x2} y1="18" y2="18" />
          <circle class="before" cx={r.x2} cy="18" r="4.5" />
          <circle class="after" cx={r.x1} cy="18" r="5.5" />
        </svg>
        <span class="val">{r.saved}</span>
        <span class="sr">: {r.before} before, {r.after} after Smart.</span>
      </li>
    ))}
  </ol>

  <div class="axis" aria-hidden="true">
    <span></span>
    <svg width="100%" height="22" focusable="false">
      {ticks.map((t) => <text x={t.x} y="15" text-anchor={t.anchor}>{t.label}</text>)}
    </svg>
    <span></span>
  </div>

  <figcaption>
    <b>Fig. 1.</b> Smart mode, sample by sample, on a logarithmic axis: equal lengths mean equal ratios.
    Each original size is the real size of the sample; each output size is worked out from the measured percentage.
  </figcaption>
</figure>

<style>
  .fig {
    --before: #3b63e0;
    --after: #0a8f63;
    margin-top: 14px;
    padding: clamp(18px, 2.6vw, 28px);
  }
  @media (prefers-color-scheme: dark) {
    .fig { --before: #6a8ff5; --after: #1faa78; }
  }
  .head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; margin-bottom: 12px; }
  .legend { display: flex; gap: 18px; color: var(--ink-2); font-size: 0.875rem; font-weight: 500; }
  .legend li { display: flex; align-items: center; gap: 7px; }
  .readout { min-height: 1.4em; color: var(--ink-2); font-size: 0.8125rem; white-space: pre-wrap; }

  .rows li, .axis {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) 52px;
    align-items: center;
    column-gap: 14px;
  }
  .rows li {
    margin-inline: -10px;
    padding-inline: 10px;
    border-radius: 10px;
    transition: background-color 0.12s;
  }
  .rows li:hover, .rows li:focus-visible { background: var(--surface-2); }
  .rows li:focus-visible { outline-offset: -2px; }
  .name { font-size: 0.9375rem; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .val { text-align: right; font-size: 0.9375rem; font-weight: 650; font-variant-numeric: tabular-nums; }
  svg { display: block; overflow: visible; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .link { stroke: var(--after); stroke-width: 2; stroke-linecap: round; opacity: 0.45; }
  .before { fill: var(--surface); stroke: var(--before); stroke-width: 2; }
  .after { fill: var(--after); stroke: var(--surface); stroke-width: 2; }
  .rows li:hover .before, .rows li:focus-visible .before { fill: var(--surface-2); }
  .rows li:hover .after, .rows li:focus-visible .after { stroke: var(--surface-2); }
  .axis { margin-top: 2px; }
  .axis text { fill: var(--ink-3); font-family: var(--font-mono); font-size: 11px; }
  figcaption { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--line); color: var(--ink-2); font-size: 0.875rem; line-height: 1.5; }
  figcaption b { color: var(--ink); }

  /* Narrow screens: the name sits above its track, so the plot keeps its width. */
  @media (max-width: 640px) {
    .rows li { grid-template-columns: minmax(0, 1fr) 44px; column-gap: 8px; padding-block: 6px 0; }
    .name { grid-column: 1 / -1; font-size: 0.8125rem; color: var(--ink-2); }
    .val { font-size: 0.875rem; }
    .axis { grid-template-columns: minmax(0, 1fr) 44px; column-gap: 8px; }
    .axis span:first-child { display: none; }
    .axis text { font-size: 10px; }
    .readout { display: none; }
  }
</style>
