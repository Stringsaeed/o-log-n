---
// A wide screenshot of the tray. AVIF with a WebP fallback, generated from
// the PNG master at build time. On small screens it scrolls sideways so the
// text stays readable.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  label: string;
}
const { src, alt, label } = Astro.props;
const widths = [1000, 1600, src.width];
const sizes = '(min-width: 1168px) 1016px, (min-width: 1040px) calc(100vw - 152px), 980px';
const [avif, webp] = await Promise.all([
  getImage({ src, widths, format: 'avif', quality: 58 }),
  getImage({ src, widths, format: 'webp', quality: 80 }),
]);
---
<div class="scroller" tabindex="0" role="group" aria-label={label}>
  <picture>
    <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
    <img src={webp.src} srcset={webp.srcSet.attribute} sizes={sizes} width={src.width} height={src.height} alt={alt} loading="lazy" decoding="async" />
  </picture>
</div>

<style>
  .scroller {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.4) transparent;
  }
  .scroller:focus-visible { outline: 2px solid #fff; outline-offset: 4px; border-radius: 12px; }
  picture { display: block; min-width: 980px; }
  img {
    display: block;
    width: 100%;
    height: auto;
    /* Matches the tray's own corner radius, so no wallpaper shows at the corners. */
    border-radius: 2.2% / 10.1%;
    box-shadow: 0 30px 60px -24px rgba(0, 0, 20, 0.8);
  }
</style>
