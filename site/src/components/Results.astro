---
// The measured results, straight from src/data/results.ts.
import Icon from './Icon.astro';
import NumberLine from './NumberLine.astro';
import Figure from './Figure.astro';
import { KINDS, RESULT_ORDER, formatLeft, formatPct } from '../data/results';

const rows = RESULT_ORDER.map((id) => ({ id, ...KINDS[id] }));
const example = KINDS.png.smart!;
---
<section class="sec" id="results" aria-labelledby="results-h">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <p class="eyebrow"><span class="math">§1</span>Measured, not promised</p>
      <h2 id="results-h" class="h2">What’s left <span class="pinch">after Logn.</span></h2>
      <p class="sub">
        Every number here was measured on a 13-file sample set. Read <span class="math"><i>n</i></span> as the size of that one sample:{' '}
        <span class="math"><i>n</i> ↦ {formatLeft(example.pct)}<i>n</i></span> means {100 - example.pct}% of it was left.
      </p>
    </div>

    <ul class="grid">
      {rows.map((r) => (
        <li class="card rcard" data-reveal>
          <div class="top">
            <h3>{r.title}</h3>
            {r.ext && <span class="ext mono" aria-hidden="true">{r.ext}</span>}
          </div>

          <div class="main">
            <p class="label"><Icon name="smart" size={15} />Smart</p>
            <p class="big engraved" data-t={formatPct(r.smart!.pct)}>{formatPct(r.smart!.pct)}</p>
            <NumberLine left={100 - r.smart!.pct} />
            <p class="fn"><span class="math" aria-hidden="true"><i>n</i> ↦ {formatLeft(r.smart!.pct)}<i>n</i></span></p>
            <p class="how">{r.smart!.how}</p>
          </div>

          <div class="alt">
            <p class="label"><Icon name="lossless" size={15} />Lossless</p>
            {r.lossless ? (
              <Fragment>
                <p class="mid">{formatPct(r.lossless.pct)}</p>
                <NumberLine left={100 - r.lossless.pct} small />
                <p class="how">{r.lossless.tag ?? r.lossless.how}</p>
              </Fragment>
            ) : (
              <p class="none">No measured figure</p>
            )}
          </div>
        </li>
      ))}
    </ul>

    <Figure />

    <div class="optimal card" data-reveal>
      <span class="oico"><Icon name="equal" size={22} /></span>
      <p>An already-compressed zip or video is reported as <b>“Already optimal”</b> in milliseconds. Logn doesn’t pretend.</p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px 20px;
  }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) {
    .grid { gap: 16px 14px; }
    .rcard { padding: 16px 14px; }
    .top h3 { font-size: 1rem; }
    .ext { display: none; }
  }
  @media (max-width: 340px) { .grid { grid-template-columns: minmax(0, 1fr); } }

  .rcard { display: flex; flex-direction: column; padding: 20px; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  h3 { font-size: 1.125rem; font-weight: 700; }
  .ext {
    flex: none;
    padding: 3px 6px;
    border-radius: 4px;
    border: var(--stroke) solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
  }
  .label {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .main { flex: 1; margin-top: 20px; }
  .main .label { color: var(--spot); }
  .big {
    margin-top: 4px;
    font-size: clamp(3.25rem, 5.4vw, 4.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .fn { margin-top: 6px; color: var(--ink); font-size: 1.1875rem; }
  .how { margin-top: 8px; color: var(--ink-2); font-size: 1rem; line-height: 1.35; }
  .alt {
    margin-top: 18px;
    padding-top: 14px;
    border-top: var(--stroke) dashed var(--rule-2);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 10px;
  }
  .mid { font-size: 1.25rem; font-weight: 700; }
  .alt :global(.nl), .alt .how { grid-column: 1 / -1; }
  .alt .how { margin-top: 6px; font-size: 0.9375rem; color: var(--ink-3); }
  .none { grid-column: 1 / -1; margin-top: 4px; color: var(--ink-3); font-size: 0.9375rem; font-style: italic; }

  .optimal {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 26px;
    padding: 18px 22px;
    color: var(--ink-2);
  }
  .optimal b { color: var(--ink); }
  .oico {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: var(--stroke) solid var(--ink);
    color: var(--ink);
  }
  /* Narrow cards: tighter labels, so nothing runs past the card's edge. */
  @media (max-width: 520px) {
    .label { font-size: 0.75rem; letter-spacing: 0.03em; gap: 4px; }
    .label :global(svg) { display: none; }
    .alt { grid-template-columns: minmax(0, 1fr) auto; column-gap: 6px; }
    .mid { font-size: 1.125rem; }
    .big { font-size: 2.875rem; }
    .fn { font-size: 1.0625rem; }
  }
</style>
