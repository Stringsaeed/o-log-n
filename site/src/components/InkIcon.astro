---
// The app icon, redrawn in pen and ink: cross-hatched body, the two arcs
// left as bare paper, the gem in the one coloured ink. Decorative; the real
// icon is in the nav.
interface Props { size?: number; class?: string }
const { size = 112, class: cls } = Astro.props;
---
<svg class:list={['ink-icon', cls]} width={size} height={size} viewBox="0 0 128 128" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="ii-body"><rect x="10" y="8" width="100" height="100" rx="25" /></clipPath>
    <clipPath id="ii-shade"><path d="M10 78C52 96 86 70 110 22V108H10Z" /></clipPath>
    <clipPath id="ii-deep"><path d="M24 108C70 110 100 88 110 54V108Z" /></clipPath>
  </defs>
  <g filter="url(#wobble)">
    <!-- cast shadow -->
    <rect x="20" y="19" width="100" height="100" rx="25" fill="url(#p-h3)" />
    <rect x="20" y="19" width="100" height="100" rx="25" fill="url(#p-h3b)" />
    <!-- body -->
    <rect class="paper" x="10" y="8" width="100" height="100" rx="25" />
    <g clip-path="url(#ii-body)">
      <rect x="10" y="8" width="100" height="100" fill="url(#p-h2)" />
      <g clip-path="url(#ii-shade)"><rect x="10" y="8" width="100" height="100" fill="url(#p-h2b)" /></g>
      <g clip-path="url(#ii-deep)"><rect x="10" y="8" width="100" height="100" fill="url(#p-h4)" /></g>
    </g>
    <rect class="line" x="10" y="8" width="100" height="100" rx="25" />
    <!-- the two arcs: an ink outline around bare paper -->
    <path class="arc-out" d="M40 32Q64 58 40 84M80 32Q56 58 80 84" />
    <path class="arc-in" d="M40 32Q64 58 40 84M80 32Q56 58 80 84" />
    <!-- the gem -->
    <path class="gem" d="M60 47l8 11-8 11-8-11z" />
  </g>
</svg>

<style>
  .ink-icon { display: block; overflow: visible; }
  .paper { fill: var(--paper); }
  .line { fill: none; stroke: var(--ink); stroke-width: 2.4; }
  .arc-out { fill: none; stroke: var(--ink); stroke-width: 13.5; stroke-linecap: round; }
  .arc-in { fill: none; stroke: var(--paper); stroke-width: 9; stroke-linecap: round; }
  .gem { fill: var(--spot); stroke: var(--ink); stroke-width: 1.8; stroke-linejoin: round; }
</style>
