---
// The app icon: renders of Support/AppIcon.icon (the Icon Composer document
// on the app branch), in its default and dark appearances. The page shows
// whichever matches the visitor's colour scheme.
import { getImage } from 'astro:assets';
import light from '../assets/icon.png';
import dark from '../assets/icon-dark.png';

interface Props {
  size: number;
  eager?: boolean;
  class?: string;
}
const { size, eager = false, class: cls } = Astro.props;
const densities = [1, 2, 3];
const make = (src: ImageMetadata) =>
  Promise.all(densities.map((d) => getImage({ src, width: size * d, height: size * d, format: 'webp', quality: 86 })));
const [l, d] = await Promise.all([make(light), make(dark)]);
const srcset = (set: Awaited<ReturnType<typeof make>>) => set.map((img, i) => `${img.src} ${densities[i]}x`).join(', ');
---
<picture>
  <source media="(prefers-color-scheme: dark)" srcset={srcset(d)} type="image/webp" />
  <img
    src={l[0].src}
    srcset={srcset(l)}
    alt=""
    width={size}
    height={size}
    class={cls}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</picture>
